{
    "name": "guppylab/plugin-directions",
    "description": "Real-route distance and ETA to multiple destinations for NativePHP Mobile: MapKit on iOS, OSRM on Android",
    "type": "nativephp-plugin",
    "license": "MIT",
    "keywords": [
        "nativephp",
        "mobile",
        "directions",
        "routing",
        "distance",
        "eta",
        "mapkit",
        "osrm"
    ],
    "authors": [
        {
            "name": "Guppylab",
            "email": "edison.filho@keepcloud.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Guppylab\\Directions\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Guppylab\\Directions\\DirectionsServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "laravel/pint": "^1.32"
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "lint:test": "pint --test"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
