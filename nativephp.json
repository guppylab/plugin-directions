{
    "name": "guppylab/plugin-directions",
    "version": "3.0.0",
    "description": "Real-route distance and travel time to multiple destinations — MapKit on iOS, OSRM on Android",
    "namespace": "Directions",
    "keywords": ["directions", "routing", "distance", "eta", "mapkit", "osrm"],
    "category": "utilities",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "author": {
        "name": "Guppylab",
        "email": "edison.filho@keepcloud.io",
        "url": "https://github.com/guppylab"
    },
    "homepage": "https://github.com/guppylab/plugin-directions",
    "repository": "https://github.com/guppylab/plugin-directions",
    "funding": [],
    "platforms": [
        "android",
        "ios"
    ],
    "screenshots": [],
    "bridge_functions": [
        {
            "name": "Directions.Distances",
            "android": "com.guppylab.plugins.directions.DirectionsFunctions.Distances",
            "android_params": ["activity"],
            "ios": "DirectionsFunctions.Distances",
            "description": "Real-route distance and travel time from an origin to multiple destinations"
        },
        {
            "name": "Directions.IsSupported",
            "android": "com.guppylab.plugins.directions.DirectionsFunctions.IsSupported",
            "android_params": ["activity"],
            "ios": "DirectionsFunctions.IsSupported",
            "description": "Whether the device can compute real routes (always true on iOS, provider-dependent on Android)"
        }
    ],
    "android": {
        "min_version": 21,
        "permissions": [
            "android.permission.INTERNET"
        ],
        "repositories": [],
        "dependencies": {
            "implementation": []
        },
        "activities": [],
        "services": [],
        "receivers": [],
        "providers": []
    },
    "ios": {
        "min_version": "15.0",
        "permissions": [],
        "repositories": [],
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "assets": {
        "android": [],
        "ios": []
    },
    "secrets": [],
    "events": [
        "Guppylab\\Directions\\Events\\DistancesReceived"
    ],
    "service_provider": "Guppylab\\Directions\\DirectionsServiceProvider",
    "hooks": {}
}
